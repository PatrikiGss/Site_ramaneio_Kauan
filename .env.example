# Modelo de configuração. Copie este arquivo para .env e ajuste os valores.
# O arquivo .env NÃO vai para o Git (guarda segredos e é específico da máquina).

# Chave secreta do Django — OBRIGATÓRIA. Gere uma nova (não reutilize a de
# exemplo) com:
#   .\venv\Scripts\python.exe -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=troque-por-uma-chave-secreta-gerada

# DEBUG=True mostra as telas técnicas de erro do Django (use só ao desenvolver).
# DEBUG=False (recomendado) usa as páginas de erro amigáveis (404, 500, etc.).
DEBUG=False

# Hosts autorizados, separados por vírgula. Para acessar pelo celular na rede
# local, acrescente o IP do computador, ex.: 127.0.0.1,localhost,192.168.0.26
ALLOWED_HOSTS=127.0.0.1,localhost

# Banco de dados. Deixando DB_NAME comentado, o sistema usa automaticamente o
# arquivo db.sqlite3 na raiz do projeto (caminho absoluto calculado sozinho —
# funciona em qualquer pasta). Só informe um caminho absoluto se quiser outro
# arquivo/banco.
DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
